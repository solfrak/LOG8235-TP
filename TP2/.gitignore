# Visual Studio 2015+ user specific files
.vs/
.vsconfig

# Unreal Engine generated files
Binaries/
Intermediate/
DerivedDataCache/
Saved/

# Builds and related files
Build/
Plugins/**/Binaries/*
Plugins/**/Intermediate/*

# Visual Studio project files (generated by the engine)
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.user
*.userprefs
*.VC.db
*.VC.opendb
*.opensdf
*.sdf

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Log files (generated during builds and runtime)
*.log

# Fortran module files
*.mod

# Precompiled Assets (if any)
SourceArt/**/*.png
SourceArt/**/*.tga

# Built data for maps
*_BuiltData.uasset

# Ignore StarterContent (if you don't want to version control it)
Content/StarterContent/*
